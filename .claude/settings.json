{
  "permissions": {
    "allow": [
      "Bash(bun run verify *)",
      "Bash(bun run lint *)",
      "Bash(bun run typecheck *)",
      "Bash(bun test *)",
      "Bash(bun install *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git switch *)",
      "Bash(git push *)",
      "Bash(gh issue view *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(podman machine start)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "bun \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.ts\"" }]
      }
    ]
  }
}
